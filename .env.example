NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time claim for a pre-provisioned workspace. Leave blank for normal SaaS tenants.
BOOTSTRAP_WORKSPACE_ID=
BOOTSTRAP_OWNER_EMAIL=

# Hiring-led Revenue Agent providers. Use dedicated keys for this app only.
CRUSTDATA_API_KEY=
ANTHROPIC_API_KEY=
# Optional override. Default is claude-sonnet-5.
ANTHROPIC_MODEL=

# Background discovery runtime context
WORKSPACE_ID=

# Optional secondary/fallback providers. Not required for the DCL hiring-led profile.
STORELEADS_API_KEY=
BUILTWITH_API_KEY=
HUNTER_API_KEY=
PROSPEO_API_KEY=

# External sending remains disabled in the current product contract.
OUTBOUND_PROVIDER_API_KEY=
